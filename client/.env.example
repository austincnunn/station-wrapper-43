# Copy to .env next to docker-compose.client.yml and fill in.
FS42_SERVER=http://192.168.1.20:5004
# from the server's Settings page (Players > Show and copy the token)
FS42_SYNC_TOKEN=
FS42_SCREEN=hd
# FS42_DRM_CONNECTOR=HDMI-A-1
# FS42_GAMMA=0
# FS42_HWDEC=no          # the CPU decodes video (default auto-safe: the graphics chip when it can)
# FS42_CHANGE_COVER=snow   # or roll: covers the wait on a channel change (default off)
# FS42_PLAYER_NAME=living-room
